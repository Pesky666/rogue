15)}
.bannerAdventure .skull{transform:scale(1.15)}
.bannerAdventure .key{transform:scale(1.1)}
@media(max-width:350px){.bannerAdventure{width:68px}.bannerAdventure:before{display:none}}
#titleBanner{
width:100%; height:auto; margin:0 0 5px 0; padding:0;
border:0; outline:0; background:#080907; overflow:hidden;
display:block;
}
#titleBanner img{
display:block; width:100%; height:auto; max-height:none;
image-rendering:auto;
}
#titleBanner:before,#titleBanner:after,.bannerAdventure{display:none!important}
#autoWrap{width:100%;height:28px;display:flex;align-items:center;margin:1px 0 3px}
#autoRoll{width:100%;height:24px;margin:0;appearance:none;-webkit-appearance:none;background:transparent;cursor:pointer;touch-action:manipulation}
#autoRoll::-webkit-slider-runnable-track{height:6px;background:#34382d;border:1px solid #f4f4ef}
#autoRoll::-webkit-slider-thumb{-webkit-appearance:none;width:22px;height:22px;margin-top:-9px;background:#f4f4ef;border:2px solid #080907;border-radius:0}
#autoRoll::-moz-range-track{height:6px;background:#34382d;border:1px solid #f4f4ef}
#autoRoll::-moz-range-thumb{width:20px;height:20px;background:#f4f4ef;border:2px solid #080907;border-radius:0}
</style>
</head>
<body>
<div id='setup'><h1>BUILD YOUR DIE</h1><p class='goal'>GOAL: GET RICH. GO DEEPER.</p><p>SET ALL 6 FACES. TAP A FACE TO CHANGE IT.</p><div id='faces'></div><div id='setupError' aria-live='polite'></div><button id='startRun' type='button'>START RUN</button></div>
<div id="game">
<div id="titleBanner"><img alt="ROLL 1dADVENTURE banner" src="data:image/png;base64,